<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in | LiveAmenity</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        :root {
            --mint: #7de8ce;
            --mint-bright: #85f0d4;
            --white: #f9fbfc;
            --muted: rgba(255,255,255,.76);
        }

        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }
        body {
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
            color: var(--white);
            background: #18272a;
        }

        .login-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 60.5% 39.5%;
            overflow: hidden;
            background: #19282a;
        }

        .hero {
            min-height: 100vh;
            position: relative;
            isolation: isolate;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 44px 54px 26px;
            background-image: url('data:image/jpeg;base64,');
            background-position: center;
            background-size: cover;
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient(90deg, rgba(13,20,32,.28), rgba(16,25,34,.05) 72%),
                        linear-gradient(0deg, rgba(9,20,23,.36), transparent 28%, rgba(18,20,31,.06));
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 17px;
            width: fit-content;
            text-decoration: none;
            color: white;
            font-size: 31px;
            line-height: 1;
            letter-spacing: -.9px;
            font-weight: 800;
        }
        .brand-mark {
            width: 63px;
            height: 63px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 17px;
            background: rgba(255,255,255,.11);
            backdrop-filter: blur(12px);
            box-shadow: 0 8px 25px rgba(0,0,0,.12);
        }
        .brand-mark svg { width: 30px; height: 30px; }
        .brand-accent { color: var(--mint); }

        .hero-copy { max-width: 670px; margin-top: 18px; margin-bottom: 22px; }
        .eyebrow {
            margin: 0 0 31px;
            color: #8df0d6;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 2.1px;
            text-transform: uppercase;
        }
        .eyebrow .dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            margin-right: 10px;
            border-radius: 50%;
            background: var(--mint);
            vertical-align: 1px;
        }
        h1 {
            margin: 0 0 19px;
            max-width: 660px;
            font-size: clamp(52px, 4.45vw, 74px);
            line-height: 1.02;
            letter-spacing: -3.5px;
            font-weight: 800;
        }
        h1 span { display: block; color: var(--mint); }
        .hero-description {
            max-width: 650px;
            margin: 0;
            font-size: 19px;
            line-height: 1.8;
            font-weight: 400;
            color: rgba(255,255,255,.94);
        }
        .hero-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            font-size: 13px;
            color: rgba(255,255,255,.94);
        }

        .login-side {
            min-height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px 46px;
            overflow: hidden;
            background: transparent;
            border-left: 1px solid rgba(255,255,255,.15);
            isolation: isolate;
        }
        .login-side::before {
            content: '';
            position: absolute;
            inset: -22px;
            z-index: -2;
            background-image: url('data:image/jpeg;base64,');
            background-size: cover;
            background-position: center;
            filter: blur(18px);
            transform: scale(1.08);
        }
        .login-side::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient(135deg, rgba(35,36,40,.60), rgba(18,31,33,.66));
        }
        .login-content { position: relative; z-index: 1; width: 100%; max-width: 500px; padding: 2px 0; }
        .form-eyebrow {
            margin: 0 0 16px;
            color: #8cebd2;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.8px;
            text-transform: uppercase;
        }
        h2 {
            margin: 0 0 13px;
            font-size: clamp(34px, 2.75vw, 45px);
            line-height: 1.12;
            letter-spacing: -1.6px;
            font-weight: 800;
        }
        .intro {
            margin: 0 0 43px;
            color: rgba(255,255,255,.75);
            font-size: 15px;
            line-height: 1.8;
        }
        .error-message {
            margin: -22px 0 22px;
            padding: 12px 14px;
            color: #ffe2e2;
            border: 1px solid rgba(255,130,130,.42);
            border-radius: 10px;
            background: rgba(110,22,22,.35);
            font-size: 13px;
            line-height: 1.5;
        }
        .field { margin-bottom: 24px; }
        .field-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            font-size: 14px;
            font-weight: 700;
        }
        .required {
            color: rgba(255,255,255,.64);
            font-size: 11px;
            font-weight: 500;
        }
        .input-wrap { position: relative; }
        .field-icon {
            position: absolute;
            left: 22px;
            top: 50%;
            width: 21px;
            height: 21px;
            color: rgba(255,255,255,.67);
            transform: translateY(-50%);
            pointer-events: none;
        }
        .field input {
            width: 100%;
            height: 66px;
            padding: 0 22px 0 56px;
            outline: none;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 13px;
            background: rgba(255,255,255,.075);
            color: white;
            font: inherit;
            font-size: 14px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
            transition: border-color .2s, background .2s, box-shadow .2s;
        }
        .field input::placeholder { color: rgba(255,255,255,.64); }
        .field input:focus {
            border-color: rgba(125,232,206,.8);
            background: rgba(255,255,255,.105);
            box-shadow: 0 0 0 3px rgba(125,232,206,.1);
        }
        .password-input { padding-right: 78px !important; }
        .show-password {
            position: absolute;
            right: 17px;
            top: 50%;
            padding: 7px 4px;
            border: 0;
            background: transparent;
            color: rgba(255,255,255,.88);
            font-family: inherit;
            font-size: 13px;
            cursor: pointer;
            transform: translateY(-50%);
        }
        .show-password:hover, .help-link:hover { color: var(--mint-bright); }
        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin: -5px 0 25px;
            font-size: 13px;
            color: rgba(255,255,255,.8);
        }
        .remember {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            cursor: pointer;
            user-select: none;
        }
        .remember input {
            width: 19px;
            height: 19px;
            margin: 0;
            accent-color: var(--mint);
            cursor: pointer;
        }
        .help-link { color: var(--mint); text-decoration: none; font-weight: 700; white-space: nowrap; }
        .submit-button {
            width: 100%;
            min-height: 66px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            border: 0;
            border-radius: 13px;
            background: linear-gradient(105deg, #83e9cf, #7cebd0);
            color: #102b29;
            font-family: inherit;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 10px 28px rgba(67,211,179,.12);
            transition: transform .18s, filter .18s, box-shadow .18s;
        }
        .submit-button:hover { transform: translateY(-1px); filter: brightness(1.04); box-shadow: 0 13px 32px rgba(67,211,179,.2); }
        .submit-button:disabled { opacity: .78; cursor: wait; transform: none; }
        .arrow { font-size: 18px; font-weight: 500; }
        .secure-note {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 9px;
            margin: 173px 0 0;
            color: rgba(255,255,255,.76);
            text-align: center;
            font-size: 12px;
        }
        .secure-note svg { width: 16px; height: 16px; flex: 0 0 auto; color: rgba(255,255,255,.7); }

        @media (max-width: 1100px) {
            .login-page { grid-template-columns: 54% 46%; }
            .hero { padding: 34px 34px 24px; }
            .login-side { padding: 38px 30px; }
            .brand { font-size: 27px; }
            .brand-mark { width: 55px; height: 55px; }
            h1 { letter-spacing: -2.4px; }
            .hero-description { font-size: 16px; }
            .intro { margin-bottom: 32px; }
            .secure-note { margin-top: 90px; }
        }
        @media (max-width: 760px) {
            .login-page { display: block; }
            .hero { min-height: 420px; padding: 26px 25px 22px; }
            .brand { gap: 12px; font-size: 25px; }
            .brand-mark { width: 48px; height: 48px; border-radius: 14px; }
            .brand-mark svg { width: 25px; height: 25px; }
            .hero-copy { margin: 54px 0 45px; }
            .eyebrow { margin-bottom: 20px; font-size: 11px; letter-spacing: 1.5px; }
            h1 { font-size: clamp(43px, 10vw, 61px); letter-spacing: -2.4px; }
            .hero-description { font-size: 15px; line-height: 1.65; }
            .hero-footer { font-size: 11px; }
            .login-side { min-height: auto; padding: 45px 25px 32px; border-left: 0; border-top: 1px solid rgba(255,255,255,.15); }
            .login-content { max-width: 500px; }
            h2 { font-size: 36px; }
            .intro { margin-bottom: 30px; }
            .field input { height: 60px; }
            .submit-button { min-height: 60px; }
            .secure-note { margin-top: 50px; }
        }
        @media (max-width: 380px) {
            .hero-footer { align-items: flex-start; flex-direction: column; gap: 8px; }
            .form-options { font-size: 12px; }
            .field-heading { font-size: 13px; }
        }
    </style>
</head>
<body>
<div class="login-page">
    <section class="hero" aria-label="Welcome to LiveAmenity">
        <a class="brand" href="<%= request.getContextPath() %>/index.jsp" aria-label="LiveAmenity home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 10 9-7 9 7"></path><path d="M5.5 9v11h13V9"></path><path d="M9.5 20v-6h5v6"></path>
                </svg>
            </span>
            <span>Live<span class="brand-accent">Amenity</span></span>
        </a>

        <div class="hero-copy">
            <p class="eyebrow"><span class="dot"></span>Shared spaces, made smarter</p>
            <h1>Welcome to <span>better living.</span></h1>
            <p class="hero-description">Discover the right shared space, check live availability, and make everyday facility access simpler for everyone in your community.</p>
        </div>

        <footer class="hero-footer">
            <span>For shared residential communities</span>
            <span>Discover · Reserve · Enjoy</span>
        </footer>
    </section>

    <main class="login-side">
        <div class="login-content">
            <p class="form-eyebrow">Resident access</p>
            <h2>Welcome back!</h2>
            <p class="intro">Sign in to explore your community's shared facilities and manage your visits.</p>

            <% if (request.getAttribute("error") != null) { %>
                <div class="error-message" role="alert"><%= request.getAttribute("error") %></div>
            <% } %>

            <form id="loginForm" action="<%= request.getContextPath() %>/login" method="post">
                <div class="field">
                    <div class="field-heading">
                        <label for="email">Email address</label>
                        <span class="required">Required</span>
                    </div>
                    <div class="input-wrap">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path>
                        </svg>
                        <input id="email" name="email" type="email" placeholder="user@example.com" autocomplete="username" required>
                    </div>
                </div>

                <div class="field">
                    <div class="field-heading">
                        <label for="password">Password</label>
                        <span class="required">Required</span>
                    </div>
                    <div class="input-wrap">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path><path d="M12 14v3"></path>
                        </svg>
                        <input class="password-input" id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required>
                        <button class="show-password" id="togglePassword" type="button" aria-controls="password" aria-pressed="false">Show</button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember" for="rememberMe">
                        <input id="rememberMe" name="rememberMe" type="checkbox" checked>
                        <span>Keep me signed in</span>
                    </label>
                    <a class="help-link" href="mailto:support@liveamenity.com?subject=LiveAmenity%20login%20help">Need help?</a>
                </div>

                <button class="submit-button" id="submitButton" type="submit">
                    <span id="submitText">Sign in to LiveAmenity</span><span class="arrow" aria-hidden="true">→</span>
                </button>
            </form>

            <p class="secure-note">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                </svg>
                <span>Bookings and facility visits, all in one place.</span>
            </p>
        </div>
    </main>
</div>
<script>
    const passwordInput = document.getElementById('password');
    const togglePassword = document.getElementById('togglePassword');
    const loginForm = document.getElementById('loginForm');
    const submitButton = document.getElementById('submitButton');
    const submitText = document.getElementById('submitText');

    togglePassword.addEventListener('click', function () {
        const shouldShow = passwordInput.type === 'password';
        passwordInput.type = shouldShow ? 'text' : 'password';
        togglePassword.textContent = shouldShow ? 'Hide' : 'Show';
        togglePassword.setAttribute('aria-pressed', String(shouldShow));
    });

    loginForm.addEventListener('submit', function () {
        if (!loginForm.checkValidity()) return;
        submitButton.disabled = true;
        submitText.textContent = 'Signing in…';
    });
</script>
</body>
</html>
